{
  "name": "pitchboard",
  "private": true,
  "type": "module",
  "version": "0.27.0",
  "description": "Animated football tactics board with client-side MP4/GIF/PNG export.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm types && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "pnpm types && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.25.0",
    "mediabunny": "^1.55.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.18",
    "wrangler": "4.127.0"
  }
}
