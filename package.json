{
  "name": "pitchboard",
  "private": true,
  "type": "module",
  "version": "0.93.0",
  "description": "Animated multi-sport tactics board with client-side MP4/GIF/PNG export.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm types && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "pnpm types && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "board": "node --experimental-strip-types scripts/board.ts",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.66.0",
    "mediabunny": "^1.65.0",
    "motion": "^13.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
