{
  // Deployed by .github/workflows/deploy-worker.yml, never by hand.
  // Locally:  pnpm build && pnpm deploy:worker --dry-run
  //
  // The Worker serves the SPA from dist/ as static assets — free, unlimited, and outside
  // the 100k requests/day free-tier budget. Only the paths named in run_worker_first
  // invoke the script and consume that budget, which is why it is an array of patterns
  // and not `true`: `true` would meter every page load as well.
  //
  // Needs wrangler >= 4.20.0 for the array form of run_worker_first.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pitchboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-30",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Ids come from `tofu output` after the first apply — the one manual step D8 accepted
  // in exchange for OpenTofu never owning the script. They are stable for the life of
  // the resources and are identifiers, not secrets.
  // A subdomain of a personal domain shared across projects. The zone is already on this
  // account (Cloudflare Registrar puts it there); the custom domain brings its own DNS record
  // and certificate. workers.dev stays on alongside it until the domain has been proved, and
  // is switched off afterwards.
  "routes": [{ "pattern": "pitchboard.migueljfsc.dev", "custom_domain": true }],

  // Public by nature: the sender every verification and reset email carries (D109). The
  // domain's SPF and DKIM records are in the OpenTofu stack.
  "vars": {
    "MAIL_FROM": "Pitchboard <noreply@pitchboard.migueljfsc.dev>"
  },

  // Sign-in, registration and reset (D109). The period can only be 10 or 60 seconds, and the
  // limiter is per Cloudflare location — it slows guessing, it does not count exactly.
  // namespace_id is any integer unique within the account.
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pitchboard-prod",
      "database_id": "2ec8251e-61e8-4262-aefc-ee5c1aa2f7fe",
      "migrations_dir": "./worker/migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "50f27ed9eeed47c7ac28252b54d040d7"
    }
  ],

  "observability": { "enabled": true }
}
